[Unit]
Description=Re-apply sysctl policy after the network is up (bootstrap/pi/hardening)
# systemd-sysctl runs early; the network stack and the CNI later rewrite some
# net.ipv4.conf.all.* keys (log_martians was found reset to 0 after boot), so
# the policy is applied once more when everything that writes them has started.
After=network-online.target kubelet.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/sysctl --system
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
