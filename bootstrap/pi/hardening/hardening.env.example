# Host-specific inputs for the hardening scripts. The real file lives on the
# host at /etc/platform-hardening/hardening.env (root:root 0600) and is never
# committed: every value below is private inventory for one machine.
#
# The uplink interface the host uses to reach the network.
UPLINK_INTERFACE=wlan0
# The interface name of the egress VPN, or empty when the host has none.
EGRESS_VPN_INTERFACE=
# UDP port the egress VPN uses on the uplink, or empty.
EGRESS_VPN_PORT=
# Systemd mount unit and root directory of a stale validation rig to remove,
# or empty when there is none.
STALE_MOUNT_UNIT=
STALE_MOUNT_ROOT=
# The orphaned admin VPN interface to retire, or empty.
ORPHAN_WG_INTERFACE=
# UDP listen port of that orphaned admin VPN, or empty.
ORPHAN_WG_PORT=
# Root-only file holding `TARGET=<address>/32`, the loopback-bound address the
# tunnel connector dials for SSH. Empty skips the sshd-listen component.
ADMIN_TARGET_FILE=
# Quoted, space-separated pod and service CIDRs of the cluster this host runs; the
# host may always reach them (probes, API hairpins).
CLUSTER_CIDRS=""
# Interactive account uid range allowed web and git egress (login.defs).
LOGIN_UID_MIN=1000
LOGIN_UID_MAX=59999
