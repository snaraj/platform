#!/usr/sbin/nft -f
# Rendered by apply-hardening.sh. Per-service egress allowlist on the output
# hook, evaluated before the distribution firewall. The firewall framework
# already denies inbound by default; this table closes the remaining gap, an
# "anything may leave through the uplink or VPN" rule, by naming which local
# user may open which outbound port. Everything else is logged and dropped.
#
# Reloads are idempotent: the table is created if absent and emptied before
# its rules are declared again, so a reload never duplicates rules. Only this
# table is touched. Never `flush ruleset` here: the CNI, the distribution
# firewall and the VPN own their own tables.
add table inet platform_egress
flush table inet platform_egress
table inet platform_egress {
  chain output {
    type filter hook output priority -10; policy accept;
    oif lo accept
    # Hairpins to the host's own addresses (API server, etcd) leave the output
    # hook with the uplink as their interface; local delivery is always allowed.
    fib daddr type local accept
    ct state established,related accept
    # DHCP and ICMP keep the uplink alive and diagnosable.
    udp sport 68 udp dport 67 accept
    meta l4proto icmp accept
    meta l4proto ipv6-icmp accept
    # Host to its own pods and service VIPs (probes, API hairpins). The CNI
    # and the cluster NetworkPolicies govern what happens past this point.
    @CLUSTER_CIDRS@
    @VPN_TRANSPORT@
    # Tunnel connector: QUIC/TCP to the edge plus its resolver.
    meta skuid "cloudflared" udp dport 7844 accept
    meta skuid "cloudflared" tcp dport 7844 accept
    meta skuid "cloudflared" udp dport 53 accept
    meta skuid "cloudflared" tcp dport 53 accept
    # Package downloads run as the apt user; image pulls run as root.
    meta skuid "_apt" tcp dport { 80, 443 } accept
    meta skuid "root" tcp dport 443 accept
    # Time: NTP and NTS key establishment. ntpd opens its sockets before it
    # drops privileges, so they are owned by root; both owners are listed.
    # NTS servers may serve time on 4123 instead of 123 (found live).
    meta skuid "root" udp dport { 123, 4123 } accept
    meta skuid "root" tcp dport 4460 accept
    meta skuid "ntpsec" udp dport { 123, 4123 } accept
    meta skuid "ntpsec" tcp dport 4460 accept
    # Interactive accounts (the operator at a shell): web, git over ssh.
    meta skuid @LOGIN_UIDS@ tcp dport { 22, 80, 443 } accept
    # The stub resolver's upstream queries.
    meta skuid "systemd-resolve" udp dport 53 accept
    meta skuid "systemd-resolve" tcp dport 53 accept
    # Everything else leaves a trace and dies here.
    limit rate 10/minute log prefix "platform-egress-drop " counter drop
    counter drop
  }
}
